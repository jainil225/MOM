uploads/
tmp/
temp/
*.wav
*.webm
*.mp3
*.m4a
*.ogg

# ── Logs ───────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pm2*.log
.pm2/

# ── Backups & scratch copies ───────────────────────────────────────
*.backup*.js
*.bak
*.orig
*.pre-*.html

# ── OS & editor files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
