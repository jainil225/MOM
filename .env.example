# Copy to .env and fill in real values. Never commit .env.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
PORT=
DATABASE_URL=
FREE_MINUTES_LIMIT=
openai_api_key=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DB_PASSWORD=
ALERT_EMAIL=
APP_URL=
NODE_ENV=
ADMIN_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PUBLIC_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SESSION_SECRET=
OPENAI_API_KEY=
SARVAM_DIARIZATION_KEY=
ASSEMBLYAI_API_KEY=

# ── Provider balance tracking (Usage page → Provider balances) ──
# Admin keys let the app read real spend from Claude / ChatGPT billing. Read-only use; never expose to the browser.
# Anthropic Console → Settings → Admin keys (starts with sk-ant-admin) · OpenAI platform → Organization → Admin keys
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
# Who gets low-balance and out-of-credit emails (comma-separated). Empty = the ALERT_EMAIL list.
BALANCE_ALERT_EMAILS=
# Default alert levels (each provider can override on the Usage page) and the ₹ per $ rate
PROVIDER_BALANCE_THRESHOLD_USD=2
PROVIDER_BALANCE_THRESHOLD_INR=1000
USD_INR=84

# ── Security ──
# SESSION_SECRET must be 32+ characters; the app will not start in production without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Longest recording or upload, in hours (default 10) ──
MAX_AUDIO_HOURS=

# ── Alerts and backups ──
OPS_ALERT_EMAILS=
ERROR_ALERT_THRESHOLD=
DISK_ALERT_PERCENT=
BACKUP_S3_URI=

# ── Signup and referral bonuses (credits) ──
# Changed here and applied on restart — no code change needed.
# JOINING_BONUS_CREDITS   : granted once to every new account
# REFERRAL_FRIEND_BONUS   : granted to the friend who signs up through an invite link
# REFERRAL_REWARD_CREDITS : granted to the referrer once that friend creates their first MOC
JOINING_BONUS_CREDITS=30
REFERRAL_FRIEND_BONUS=30
REFERRAL_REWARD_CREDITS=30

# ── Customer Google Drive storage ──
# When a customer connects their Drive, recordings are moved to their storage
# after the MOC is made and our copy is deleted. Scope used is drive.file, so the
# app can only see files it created itself.
# Leave the client id/secret blank to reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# The callback URL must be added to the OAuth client in Google Cloud Console.
DRIVE_STORAGE=on
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_CALLBACK_URL=
DRIVE_FOLDER_NAME=AiX Track Recordings
# How often to retry recordings whose move to Drive did not succeed (minutes, 0 = off)
DRIVE_SWEEP_MINUTES=30

# ── MOC speed vs depth: low | medium | high (default medium). Lower = faster and cheaper; long meetings may need medium or low ──
MOC_EFFORT=medium
